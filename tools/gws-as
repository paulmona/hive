#!/usr/bin/env python3
"""gws-as: run `gws` impersonating a Workspace user via service-account DWD.

Usage: gws-as <user_email> <gws args...>

Requires:
  - $GWS_SA_KEY_PATH (service-account JSON; default ~/.config/gws-sa.json, written by refresh-from-vault from _GWS_SA_KEY)
  - $GWS_IMPERSONATION_ALLOWLIST (comma-separated emails this agent may impersonate)

Mints a short-lived OAuth access token with `subject=<user_email>` and exec's gws
with $GOOGLE_WORKSPACE_CLI_TOKEN set. Each invocation mints a fresh token.
"""
import os
import sys

SA_KEY_PATH = os.environ.get("GWS_SA_KEY_PATH", os.path.expanduser("~/.config/gws-sa.json"))
SCOPES = [
    "https://www.googleapis.com/auth/gmail.modify",
    "https://www.googleapis.com/auth/gmail.send",
    "https://www.googleapis.com/auth/calendar",
    "https://www.googleapis.com/auth/calendar.events",
    "https://www.googleapis.com/auth/contacts.readonly",
]


def die(msg, code=2):
    print(f"gws-as: {msg}", file=sys.stderr)
    sys.exit(code)


def main():
    if len(sys.argv) < 3:
        die("usage: gws-as <user_email> <gws args...>")

    user = sys.argv[1]
    gws_args = sys.argv[2:]

    if not os.path.isfile(SA_KEY_PATH):
        die(f"service-account key not found at {SA_KEY_PATH} (is GWS_SA_KEY set in Vault?)")

    allowlist_raw = os.environ.get("GWS_IMPERSONATION_ALLOWLIST", "").strip()
    if not allowlist_raw:
        die("GWS_IMPERSONATION_ALLOWLIST is empty; refusing to impersonate any user")
    allowlist = {e.strip().lower() for e in allowlist_raw.split(",") if e.strip()}
    if user.lower() not in allowlist:
        die(f"user '{user}' not in GWS_IMPERSONATION_ALLOWLIST")

    try:
        from google.oauth2 import service_account
        from google.auth.transport.requests import Request
    except ImportError as e:
        die(f"google-auth import failed: {e}")

    creds = service_account.Credentials.from_service_account_file(
        SA_KEY_PATH, scopes=SCOPES, subject=user
    )
    creds.refresh(Request())

    env = os.environ.copy()
    env["GOOGLE_WORKSPACE_CLI_TOKEN"] = creds.token
    env.pop("GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE", None)
    os.execvpe("gws", ["gws", *gws_args], env)


if __name__ == "__main__":
    main()
